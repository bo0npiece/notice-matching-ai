# 1이면 실제 호출 없이 가짜 응답. 키가 비어 있어도 자동으로 MOCK.
MOCK_MODE=1
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com

# 모델 역할 분담
MODEL_ANALYSIS=HCX-007
MODEL_VISION=HCX-005
MODEL_LIGHT=HCX-DASH-002
CLOVA_TIMEOUT_SECONDS=60

# 당일 교체 영역과 저장 폴더
CUSTOMIZE_DIR=customize
DATA_DIR=data

# 크레딧 절약: 동일 요청 캐시(초), 실제 호출 횟수 한도, 누적 토큰 중단 기준
CACHE_TTL_SECONDS=3600
MAX_LIVE_CALLS=300
TOKEN_STOP_THRESHOLD=200000

# 허용할 프론트 주소(쉼표 구분). * 이면 전체 허용
CORS_ORIGINS=*
# 외부 공유 시 설정, 프론트는 X-Team-Key 헤더로 전달
TEAM_API_KEY=
