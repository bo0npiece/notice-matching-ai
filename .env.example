# 처음에는 true: 외부 API를 호출하지 않는 고정 예시 응답
MOCK_MODE=true
CLOVA_API_KEY=
CLOVA_BASE_URL=https://clovastudio.stream.ntruss.com
CLOVA_TEXT_MODEL=HCX-DASH-002
CLOVA_VISION_MODEL=HCX-005
# 해커톤에서 지급된 URL/모델이 다르면 위 값을 변경하세요.
CLOVA_TIMEOUT_SECONDS=60
DATABASE_PATH=data/hackathon.sqlite3
TASKS_PATH=tasks.json
CACHE_TTL_SECONDS=3600
# 실제 호출 시도 횟수 제한. 모의 실행은 제외합니다.
MAX_LIVE_CALLS=300
# 누적 토큰이 이 값을 넘으면 다음 호출을 중단. 1회 호출 중 초과 가능.
TOKEN_STOP_THRESHOLD=200000
# 팀 프론트엔드 주소를 쉼표로 구분합니다.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 외부 공유 시 설정하고 프론트엔드에서 X-Team-Key 헤더로 전달합니다.
TEAM_API_KEY=
